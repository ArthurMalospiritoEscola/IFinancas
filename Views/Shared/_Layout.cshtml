<!DOCTYPE html>
<html lang="pt-br">
<head>
    <!-- Conexão da font-family -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> - IFinanças - </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/IFinancas.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color:#137224">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="navbar-brand title ms-2" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/ifmt-logo.png" alt="IF Logo" width="30" height="40">
                        <span class="fs-3">IFinanças</span>
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="nav-item d-flex align-items-center me-3">
                        <span class="text-white">Olá, <strong>@User.Identity.Name</strong>!</span>
                    </li>
                    <li class="nav-item me-3">
                        <form asp-controller="Usuario" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="nav-link btn btn-link border-0 p-0"><span class="hover-underline sair">Sair</span></button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Usuario" asp-action="Login">Entrar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Usuario" asp-action="Registro">Cadastrar</a>
                    </li>
                }
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="background-color:#137224">
        <div class="container text-light">
            &copy; 2026 - IFinanças - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-light">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
